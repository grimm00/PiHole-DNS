# Copy to `.env` in this directory (next to docker-compose.yml) and set real values.
# The real `.env` file is gitignored — never commit it.
#
# Layer 0 — Pi-hole (required)
# Web UI / API password (Pi-hole v6). Also used by pihole-exporter — see below.
FTLCONF_webserver_api_password=your-secure-password-here
#
# Layer 2 spike — Grafana (required when grafana service is enabled)
# Admin login at http://<host>:3000 — never commit the real password.
GF_SECURITY_ADMIN_PASSWORD=your-grafana-admin-password-here
#
# pihole-exporter: built from docker/pihole6-exporter (arm64 Pi); reuses FTLCONF_webserver_api_password (mapped to PIHOLE_API_TOKEN in
# docker-compose.yml). Set the Pi-hole password once; no second secret.
# See docs/maintainers/planning/features/layer-2-observable/spike-outcomes.md § pihole-exporter.
#
# docker-exporter: host docker group GID for read-only socket (image runs as UID 65532).
# Pi: DOCKER_GID=$(getent group docker | cut -d: -f3)
DOCKER_GID=991
#
# node-exporter: no additional secrets.
#
# Desk rootless Podman (optional — see docker-compose.desk.yml + manual-testing.md):
# Omit on Pi (defaults 53/80). Use any free host port >= 1024; avoid 5353 (mDNS).
# PIHOLE_HOST_DNS_PORT=15353
# PIHOLE_HOST_WEB_PORT=18080
